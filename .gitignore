# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# research raw dumps / cookies (content-gen only)
research/raw/**
!research/raw/.gitkeep
!research/raw/**/.gitkeep
!research/raw/xhs-cookies.txt.example
research/**/cookies*.json
research/**/auth.json
research/raw/xhs-cookies.txt


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
